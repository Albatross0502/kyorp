          priceINR: priceINR,
          tone: div.tone
        });
      });

      /* ==========================================================================
         4. STATE & STORAGE (STORE)
         ========================================================================== */
      const STATE = {
        lang: localStorage.getItem("kyorp_lang") || "en",
        curr: localStorage.getItem("kyorp_curr") || "INR",
        cart: JSON.parse(localStorage.getItem("kyorp_cart") || "[]"),
        wishlist: JSON.parse(localStorage.getItem("kyorp_wish") || "[]"),

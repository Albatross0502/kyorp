              </div>
            </div>
          `;
        }).join("");

        const shipping = subtotalINR >= CONFIG.shippingThresholdINR ? 0 : CONFIG.flatShippingINR;
        const total = subtotalINR + shipping;

        document.getElementById("cart-subtotal").textContent = formatPrice(subtotalINR);
        document.getElementById("cart-shipping").textContent = shipping === 0 ? "Complimentary" : formatPrice(shipping);
        document.getElementById("cart-total").textContent = formatPrice(total);
      }


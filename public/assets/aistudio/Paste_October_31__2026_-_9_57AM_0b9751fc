              </div>
              <div style="display: flex; align-items: center; border: 1px solid var(--line); border-radius: var(--radius);">
                <button type="button" style="padding: 4px 10px;" aria-label="Decrease quantity" onclick="window.changeCartQty('${item.sku}', -1)">-</button>
                <span style="padding: 0 10px; font-size: 13px;">${item.qty}</span>
                <button type="button" style="padding: 4px 10px;" aria-label="Increase quantity" onclick="window.changeCartQty('${item.sku}', 1)">+</button>

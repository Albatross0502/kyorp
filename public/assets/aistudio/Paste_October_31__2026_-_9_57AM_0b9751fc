          const prod = ALL_PRODUCTS.find(p => p.sku === item.sku) || {};
          const itemSubtotal = prod.priceINR * item.qty;
          subtotalINR += itemSubtotal;

          return `
            <div style="display: flex; gap: 20px; align-items: center; background: var(--ivory); border: 1px solid var(--line); padding: 18px; border-radius: var(--radius); flex-wrap: wrap;">

      /* ==========================================================================
         7. VIEW ROUTER & NAVIGATION CONTROLLER
         ========================================================================== */
      function navigateTo(hash) {
        const clean = (hash || "#home").replace("#", "");
        let viewName = "home";
        let params = {};

        if (clean.includes("?")) {
          const parts = clean.split("?");
          viewName = parts[0];
          const query = new URLSearchParams(parts[1]);
          for (const [k, v] of query.entries()) params[k] = v;
        } else {
          viewName = clean || "home";
        }

        // Clean up transient form success banners on view change
        const instMsg = document.getElementById("inst-success-msg");
        const contactMsg = document.getElementById("contact-success-msg");
        const newsMsg = document.getElementById("newsletter-thanks");
        if (instMsg) instMsg.style.display = "none";
        if (contactMsg) contactMsg.style.display = "none";
        if (newsMsg) newsMsg.style.display = "none";

        // Hide all views
        document.querySelectorAll(".page-view").forEach(el => el.classList.remove("active"));

        // Match view
        const targetView = document.getElementById(`view-${viewName}`) || document.getElementById("view-home");
        targetView.classList.add("active");
        STATE.currentView = viewName;
        window.scrollTo({ top: 0, behavior: "smooth" });

        // Update nav active link
        document.querySelectorAll(".nav-link").forEach(link => {
          link.classList.toggle("active", link.getAttribute("href") === `#${viewName}`);
        });

        // Close mobile drawer
        document.getElementById("mobile-menu").classList.remove("open");

        // Execute view render hooks
        if (viewName === "home") renderHome();
        else if (viewName === "collections") renderCollections();
        else if (viewName === "category") {
          if (params.d && params.d !== STATE.categoryParams.divId) {
            STATE.categoryParams.divId = params.d;
            STATE.categoryParams.typeFilter = "all";
            STATE.categoryParams.page = 1;
          }
          renderCategory();
        }
        else if (viewName === "product") {
          if (params.sku) STATE.currentSku = params.sku;
          renderProduct();
        }
        else if (viewName === "cart") renderCart();
        else if (viewName === "wishlist") renderWishlist();
      }

      window.addEventListener("hashchange", () => navigateTo(window.location.hash));


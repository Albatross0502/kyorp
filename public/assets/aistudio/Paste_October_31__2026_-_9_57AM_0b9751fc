        if (badge) badge.textContent = count;
      }

      /* ==========================================================================
         5. CURRENCY FORMATTER
         ========================================================================== */
      function formatPrice(amountINR) {
        if (!amountINR || amountINR <= 0) return "In Development";
        const c = CONFIG.currencies[STATE.curr];
        const converted = amountINR * c.rateFromINR;

        if (STATE.curr === "INR") {
          return new Intl.NumberFormat("en-IN", {
            style: "currency",
            currency: "INR",
            maximumFractionDigits: 0
          }).format(converted);
        } else {
          return new Intl.NumberFormat(c.locale, {
            style: "currency",
            currency: STATE.curr,
            maximumFractionDigits: 2
          }).format(converted);
        }
      }


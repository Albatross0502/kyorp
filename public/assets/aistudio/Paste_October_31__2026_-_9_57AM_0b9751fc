      // 8.3 CATEGORY RENDERER (WITH PAGINATION)
      function renderCategory() {
        const div = DIVISIONS.find(d => d.id === STATE.categoryParams.divId) || DIVISIONS[0];

        document.getElementById("cat-hero-title").textContent = div.name;
        document.getElementById("cat-hero-desc").textContent = div.desc;

        const badge = document.getElementById("cat-badge-status");
        badge.className = div.status === "live" ? "badge-live" : "badge-dev";
        badge.textContent = div.status === "live" ? "Commercial Active Range" : "In Development — Subject to Regulatory Filing";

        const divProducts = ALL_PRODUCTS.filter(p => p.divisionId === div.id);

        // Filter chips
        const types = ["all", ...new Set(divProducts.map(p => p.type))];
        const chipsWrap = document.getElementById("cat-type-chips");
        chipsWrap.innerHTML = types.map(t => {
          const isSel = t === STATE.categoryParams.typeFilter;
          return `
            <button type="button" class="pref-pill ${isSel ? 'selected' : ''}" aria-pressed="${isSel}" onclick="window.filterCatType('${t}')">
              ${t.toUpperCase()}
            </button>
          `;
        }).join("");

        // Filter & Sort
        let filtered = [...divProducts];
        if (STATE.categoryParams.typeFilter !== "all") {
          filtered = filtered.filter(p => p.type === STATE.categoryParams.typeFilter);
        }

        const sortVal = document.getElementById("cat-sort-select").value || "sku";
        if (sortVal === "name") filtered.sort((a,b) => a.name.localeCompare(b.name));
        else if (sortVal === "price-asc") filtered.sort((a,b) => a.priceINR - b.priceINR);
        else if (sortVal === "price-desc") filtered.sort((a,b) => b.priceINR - a.priceINR);
        else filtered.sort((a,b) => a.skuNum - b.skuNum);

        // Pagination (12 per page)
        const pageSize = 12;
        const visibleProducts = filtered.slice(0, STATE.categoryParams.page * pageSize);

        document.getElementById("cat-count-label").textContent = `Showing ${visibleProducts.length} of ${filtered.length} Formulations`;

        const grid = document.getElementById("cat-products-grid");
        grid.innerHTML = visibleProducts.map(p => createProductCardHTML(p)).join("");

        const loadMoreWrap = document.getElementById("cat-load-more-wrap");
        const loadMoreBtn = document.getElementById("cat-load-more-btn");
        if (loadMoreWrap && loadMoreBtn) {
          if (visibleProducts.length < filtered.length) {
            loadMoreWrap.style.display = "block";
            loadMoreBtn.onclick = () => {
              STATE.categoryParams.page += 1;
              renderCategory();
            };
          } else {
            loadMoreWrap.style.display = "none";
          }
        }
      }


        categoryParams: { divId: "skin-science", typeFilter: "all", sort: "sku", page: 1 },
        currentSku: "001"
      };

      function saveStore() {
        localStorage.setItem("kyorp_lang", STATE.lang);
        localStorage.setItem("kyorp_curr", STATE.curr);
        localStorage.setItem("kyorp_cart", JSON.stringify(STATE.cart));
        localStorage.setItem("kyorp_wish", JSON.stringify(STATE.wishlist));
        updateCartCount();
        updateWishCount();
      }

      function updateCartCount() {
        const count = STATE.cart.reduce((sum, item) => sum + item.qty, 0);
        const badge = document.getElementById("cart-counter");
        if (badge) badge.textContent = count;
      }

      function updateWishCount() {
        const count = STATE.wishlist.length;
